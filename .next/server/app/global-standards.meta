{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/global-standards/layout,_N_T_/global-standards/page,_N_T_/global-standards"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/global-standards/__PAGE__",
    "/global-standards",
    "/_index",
    "/_head"
  ]
}