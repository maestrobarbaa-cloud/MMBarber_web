{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/vouchery/layout,_N_T_/vouchery/page,_N_T_/vouchery"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/vouchery/__PAGE__",
    "/vouchery",
    "/_index",
    "/_head"
  ]
}