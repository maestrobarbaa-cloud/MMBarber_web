rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Internal Identity & Voting System Security
    match /level_votes/{voteId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if request.resource.data.userId is string
        && voteId == request.resource.data.userId + "_" + request.resource.data.date
        && request.resource.data.ratings.values().all(val => val >= 0 && val <= 7)
        && request.resource.data.timestamp == request.time;
      allow delete: if false;
    }

    // Barbers Community Ranks & XP Stats
    match /barbers/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Seznamka – zprávy zájemkyň
    match /seznamka_requests/{docId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 80
        && request.resource.data.idealMan is string
        && request.resource.data.idealMan.size() > 0
        && request.resource.data.idealMan.size() <= 500;
      allow read, update, delete: if true;
    }

    // Barber Inbox – novinky, tipy, pochvaly od klientů
    match /barber_novinky/{docId} {
      allow create: if request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.category is string;
      allow read, update, delete: if true;
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

